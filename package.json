{
  "name": "dsh-llm-gateway",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "OpenAI-compatible gateway that exposes every model configured in DeepSeek Harness on a local port (default 2778), so other agent tools can call those models through the harness provider adapters.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "llm",
    "openai-compatible",
    "gateway"
  ],
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
